---
import "../styles/global.css";
import { site, author } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getUi, type Locale } from "../i18n";

export interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage, locale = "en" } = Astro.props;
const ui = getUi(locale);
const pageTitle = title ? `${title} — ${site.title}` : site.tabTitle;
const pageDescription = description || ui.description || site.description;

const currentPath = Astro.url.pathname;
const socialImage = new URL(ogImage || author.avatar.src, site.url).href;
const twitterHandle = author.x ? `@${author.x}` : undefined;
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    {site.preview && <meta name="robots" content="noindex, nofollow" />}

    <!-- Fonts: self-hosted variable fonts, preloaded (all above the fold) -->
    <link rel="preload" href="/fonts/Newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NotoSerifSC-sample.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>

    <link rel="canonical" href={new URL(currentPath, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL("/", site.url).href} />
    <link rel="alternate" hreflang="zh-CN" href={new URL("/zh-cn/", site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", site.url).href} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={new URL(currentPath, site.url).href} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
    <meta property="og:locale:alternate" content={locale === "en" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={socialImage} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}

    <!-- Favicon -->
    <link rel="icon" href="/images/favicon/favicon.ico?v=suyang-ma-20261121" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png?v=suyang-ma-20261121" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png?v=suyang-ma-20261121" />
    <link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png?v=suyang-ma-20261121" />
    <link rel="manifest" href="/images/site.webmanifest?v=suyang-ma-20261121" />

    <!-- Google Analytics -->
    {site.analyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId: site.analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{ui.skip}</a>

    <Header locale={locale} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      // Set stagger delays via CSS custom property so any number of children works
      document.querySelectorAll(".reveal-stagger").forEach((el) => {
        Array.from(el.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty("--stagger-delay", `${i * 0.1}s`);
        });
      });

      // Scroll reveal animation
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
      );

      document.querySelectorAll(".reveal, .reveal-stagger").forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
