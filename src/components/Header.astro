---
import { navigation } from "../config";
import { getUi, type Locale } from "../i18n";
export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const ui = getUi(locale);
const navLabels: Record<string, string> = ui.nav;
---

<header class="site-header">
  <div class="content-container">
    <nav class="header-navigation" aria-label={ui.navigation}>
      <ul class="site-nav">
        {navigation.header.map((item) => (
          <li>
            <a href={`${ui.path}${item.href.slice(item.href.indexOf("#"))}`}>{navLabels[item.href.split("#")[1]] ?? item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="language-switcher" aria-label={locale === "en" ? "Language" : "语言"}>
      <a class="language-option" href="/" lang="en" hreflang="en"
        aria-current={locale === "en" ? "page" : undefined} data-language-switch>English</a>
      <a class="language-option" href="/zh-cn/" lang="zh-CN" hreflang="zh-CN"
        aria-current={locale === "zh-cn" ? "page" : undefined} data-language-switch>中文</a>
    </nav>
  </div>
</header>

<script>
  // Language pages share section IDs; retain the current section when switching.
  const languageLinks = document.querySelectorAll<HTMLAnchorElement>("[data-language-switch]");
  function updateLanguageLink() {
    languageLinks.forEach((link) => {
      const target = new URL(link.href);
      target.hash = window.location.hash;
      link.href = target.href;
    });
  }
  updateLanguageLink();
  window.addEventListener("hashchange", updateLanguageLink);

  const links = [...document.querySelectorAll<HTMLAnchorElement>(".site-nav a")];
  const items = links.flatMap((link) => {
    const id = link.hash.slice(1);
    const section = id ? document.getElementById(id) : null;
    return section ? [{ link, section }] : [];
  });

  // A section counts once its top reaches the spot scroll-margin parks it,
  // just under the sticky header. The active link follows the visible section.
  function update() {
    if (items.length === 0) return;
    const header = document.querySelector(".site-header");
    const headerH = header?.getBoundingClientRect().height ?? 0;
    let current = items[0];
    for (const item of items) {
      const margin = parseFloat(getComputedStyle(item.section).scrollMarginTop) || 0;
      const line = Math.max(headerH, margin) + 8;
      if (item.section.getBoundingClientRect().top <= line) current = item;
    }
    // The last sections cannot reach the line when the page runs out.
    // At the bottom, mark the lowest nav section still on screen.
    const atBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) {
      const visible = items.filter((item) => {
        const rect = item.section.getBoundingClientRect();
        return rect.bottom > headerH && rect.top < window.innerHeight;
      });
      if (visible.length > 0) current = visible[visible.length - 1];
    }
    for (const item of items) {
      const on = item === current;
      item.link.classList.toggle("active", on);
      if (on) item.link.setAttribute("aria-current", "true");
      else item.link.removeAttribute("aria-current");
    }
  }

  update();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  window.addEventListener("hashchange", update);
</script>
