---
import { author, homePage } from "../config";
import { Image } from "astro:assets";
import { externalLinkAttrs } from "../utils/links";
import { getUi, type Locale } from "../i18n";
import GitHubIcon from "./icons/GitHubIcon.astro";
import ScholarIcon from "./icons/ScholarIcon.astro";
export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const ui = getUi(locale);

const links = [
  author.github && { href: `https://github.com/${author.github}`, label: "GitHub" },
  author.googleScholar && { href: author.googleScholar, label: ui.scholar },
  author.x && { href: `https://x.com/${author.x}`, label: "X" },
  author.orcid && { href: author.orcid, label: "ORCID" },
].filter((l): l is { href: string; label: string } => Boolean(l));
---

<section class="hero" id="about">
  <div class="content-container">
    <div class="hero-inner">
      <div class="hero-lockup">
        <Image class="hero-avatar" src={author.avatar} alt={author.name} width={960} widths={[320, 640, 960]} sizes="(max-width: 785px) 220px, (max-width: 1143px) 28vw, 320px" format="webp" quality={85} loading="eager" />
        <div class="hero-copy">
          <h1>{locale === "en" ? homePage.name : homePage.nameCn}<span class="hero-name-cn">{locale === "en" ? homePage.nameCn : homePage.name}</span></h1>
          <p class="hero-subtitle">{ui.subtitle ?? homePage.subtitle}</p>
          <p class="hero-links">
            {author.email && (
              <a class="email-link" href={`mailto:${author.email}`}>{author.email}</a>
            )}
            {links.map((l) => (
              <a href={l.href} {...externalLinkAttrs(l.href)}>
                {l.label === "GitHub" && <GitHubIcon />}
                {l.href === author.googleScholar && <ScholarIcon />}
                <span>{l.label}</span>
              </a>
            ))}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
