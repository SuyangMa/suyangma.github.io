---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import CitationCount from "../components/CitationCount.astro";

import { author, homePage } from "../config";
import { mdInline } from "../utils/content";

import { getUi, getContent, type Locale } from "../i18n";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const ui = getUi(locale);
const { intro: introRaw, education, experience, news, publications,
  projects: projectsData, honors, services: servicesData, skills } = getContent(locale);

type Project = { date: string; title: string; role: string; description: string; link?: string };
type ServiceSection = { heading: string; items: { role: string; text: string }[] };
const projects = projectsData as Project[];
const services = servicesData as { sections: ServiceSection[] };

const s = homePage.sections;

const scholarUrl = (paperId: string) =>
  `https://scholar.google.com/citations?view_op=view_citation&hl=en&user=${author.googleScholarId}&citation_for_view=${paperId}`;

const introParagraphs = introRaw.trim().split(/\n\n+/);

const ymToDate = (ym: string) => {
  const [y, m, d] = ym.split(".");
  return new Date(Number(y), Number(m || 1) - 1, Number(d || 1)).getTime();
};

type NewsItem = {
  date: string;
  text: string;
  link?: string;
  linkText?: string;
  suffix?: string;
  detail?: string;
};

const newsItems = ([...news] as NewsItem[])
  .sort((a, b) => ymToDate(b.date) - ymToDate(a.date))
  .slice(0, 5);

type Paper = {
  title: string;
  venue: string;
  paperId?: string;
  /** Direct link (e.g. arXiv); takes precedence over the Scholar link. */
  link?: string;
  authors: string;
  journal?: string;
  year?: number;
  note?: string;
};
type PubSection = { heading: string; papers: Paper[] };
const pubSections = (publications.sections as PubSection[]);
---

<BaseLayout locale={locale} ogImage="/images/social-preview.png">
  <Hero locale={locale} />

  {s.aboutMe && (
    <div class="reveal">
      <section class="section">
        <div class="content-container">
          {introParagraphs.map((p: string) => <p set:html={mdInline(p.trim())} />)}
        </div>
      </section>
    </div>
  )}

  {s.news && newsItems.length > 0 && (
    <div class="reveal">
      <Section title={ui.sections.news} id="news">
        <ul class="row-list reveal-stagger">
          {newsItems.map((item) => (
            <li class="row">
              <span class="row-label">{item.date}</span>
              <div class="row-body">
                <div class="row-title">
                  {item.text}
                  {item.link && <a href={item.link}>{item.linkText ?? item.link}</a>}
                  {item.suffix && <>{item.suffix}</>}
                </div>
                {item.detail && <div class="row-sub">{item.detail}</div>}
              </div>
            </li>
          ))}
        </ul>
      </Section>
    </div>
  )}

  {s.experience && (
    <div class="reveal">
      <Section title={ui.sections.experience} id="experience">
        <ul class="row-list reveal-stagger">
          {experience.map((item) => (
            <li class="row">
              <span class="row-label">{item.date}</span>
              <div class="row-body">
                <div class="row-title"><strong>{item.title}</strong>{locale === "en" ? ", " : "，"}{item.company}{locale === "en" ? "." : "。"}</div>
                <div class="row-desc">{item.description}</div>
              </div>
            </li>
          ))}
        </ul>
      </Section>
    </div>
  )}

  {s.publications && (
    <div class="reveal">
      <Section title={ui.sections.publications} id="publications">
        {pubSections.map((section) => (
          <>
            <p class="cv-subheading">{section.heading}</p>
            {section.papers.map((paper) => {
              const href = paper.link ?? (paper.paperId ? scholarUrl(paper.paperId) : null);
              return (
              <div class="row">
                <span class="row-label">{paper.venue}</span>
                <div class="row-body">
                  <div class="row-title">
                    {href ? (
                      <a href={href}>{paper.title}</a>
                    ) : (
                      paper.title
                    )}
                    {paper.note && <span class="publication-note"> {paper.note}</span>}
                  </div>
                  <div class="row-sub">
                    {paper.paperId && <CitationCount paperId={paper.paperId} locale={locale} />}
                    <span set:html={mdInline(paper.authors)} />
                  </div>
                  {paper.journal && (
                    <div class="row-sub publication-journal">
                      <strong><em>{paper.journal}</em></strong>{paper.year && <>, {paper.year}</>}
                    </div>
                  )}
                </div>
              </div>
              );
            })}
          </>
        ))}
      </Section>
    </div>
  )}

  {s.education && (
    <div class="reveal">
      <Section title={ui.sections.education} id="education">
        <ul class="row-list reveal-stagger">
          {education.map((item) => (
            <li class="row">
              <span class="row-label">{item.date}</span>
              <div class="row-body">
                <div class="row-title"><strong>{item.title}</strong>{locale === "en" ? ", " : "，"}{item.school}{locale === "en" ? "." : "。"}</div>
                <div class="row-desc">{item.description}</div>
              </div>
            </li>
          ))}
        </ul>
      </Section>
    </div>
  )}

  {s.projects && (
    <div class="reveal">
      <Section title={ui.sections.projects} id="projects">
        {projects.map((item) => (
          <div class="row">
            <span class="row-label">{item.date}</span>
            <div class="row-body">
              <div class="row-title">
                {item.link ? (
                  <a href={item.link}>{item.title}</a>
                ) : (
                  item.title
                )}
                <span class="row-meta">{item.role}</span>
              </div>
              <div class="row-desc">{item.description}</div>
            </div>
          </div>
        ))}
      </Section>
    </div>
  )}

  {s.honors && (
    <div class="reveal">
      <Section title={ui.sections.honors} id="honors">
        <div class="rows-compact">
          {honors.sections.map((section) => (
            <>
              <p class="cv-subheading">{section.heading}</p>
              {section.items.map((item) => (
                <div class="row">
                  <span class="row-label">{item.date}</span>
                  <div class="row-body">
                    <span class="row-text">{item.text}</span>
                  </div>
                </div>
              ))}
            </>
          ))}
        </div>
      </Section>
    </div>
  )}

  {s.services && (
    <div class="reveal">
      <Section title={ui.sections.services} id="services">
        <div class="rows-compact">
          {services.sections.map((section) => (
            <>
              <p class="cv-subheading">{section.heading}</p>
              {section.items.map((item) => (
                <div class="row">
                  <span class="row-label">{item.role}</span>
                  <div class="row-body">
                    <span class="row-text">{item.text}</span>
                  </div>
                </div>
              ))}
            </>
          ))}
        </div>
      </Section>
    </div>
  )}

  {s.skills && (
    <div class="reveal">
      <Section title={ui.sections.skills} id="skills">
        <div class="skill-tags">
          {skills.map((skill: string) => (
            <span class="skill-tag">{skill}</span>
          ))}
        </div>
      </Section>
    </div>
  )}
</BaseLayout>
